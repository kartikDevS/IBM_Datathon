# TessNova Cybersecurity Contribution - Environment Variables Template
# Copy this file to .env for local testing (NEVER commit .env)

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60

# MQTT Authentication (Use designated test credentials)
MQTT_USERNAME=test_agent_user
MQTT_PASSWORD=test_agent_password_placeholder

# Client Identifiers
MQTT_CLIENT_ID_PREFIX=tessnova_sec_

# Telemetry Topic Configurations
MQTT_TELEMETRY_TOPIC_ROOT=ward/
MQTT_INCIDENT_TOPIC=hospital/security/incidents

# M4 Replay Detector Settings
M4_STALE_TIMESTAMP_WINDOW_SEC=5.0
M4_SEQUENCE_GAP_THRESHOLD=100
M4_DEVICE_RESTART_THRESHOLD=1000

# M5 Network Witness Settings
M5_MODEL_PATH=m5_network_witness/artifacts/m5_model_baseline.joblib
M5_INFERENCE_THRESHOLD=0.75

# Mosquitto Dynamic Security Configuration
DYNSEC_ADMIN_USER=admin
DYNSEC_ADMIN_PASSWORD=admin_password_placeholder
DYNSEC_CONFIG_PATH=/var/lib/mosquitto/dynamic-security.json
DYNSEC_CLI_PATH=mosquitto_ctrl
